# Keepa API Configuration
# Get your free API key at https://keepa.com/#!api
# Free tier: 100 tokens/day (sufficient for daily bestsellers + price history)
KEEPA_API_KEY=your_64_character_keepa_api_key_here

# Optional: Keepa domain (1=US, 2=UK, 3=DE, 4=FR, 5=JP, 6=CA, 7=IT, 8=ES)
# KEEPA_DOMAIN=1

# Optional: Request delay for rate limiting (seconds)
# KEEPA_REQUEST_DELAY=2.0
